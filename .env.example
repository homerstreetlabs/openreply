# App
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-a-strong-random-secret
CRON_SECRET=replace-with-a-strong-random-secret
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Database
# Local only. Never set this value as a Worker secret: the Workers socket layer
# refuses localhost and private addresses. Use the real connection string there.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/openreply

# Sender address. Required, not defaulted, and it must be on the domain you
# onboarded to Cloudflare Email Sending, because Cloudflare rejects any other.
EMAIL_FROM=OpenReply <login@example.com>

# SMTP, used only OUTSIDE a Worker: scripts, tests and `pnpm dev`. In production
# the Workers EMAIL binding sends instead and this is never read.
#
# A Worker cannot reach smtp.mx.cloudflare.net at all. Cloudflare IPs are on the
# Workers socket layer's disallowed list alongside localhost and private
# addresses, so this URL fails from inside a Worker. The bridge is for clients
# that are not Workers. URL-encode special characters (@ becomes %40).
# Local and scripts only. In production the Workers `EMAIL` binding sends, and a
# Worker cannot reach Cloudflare's SMTP relay: Cloudflare IPs are on the socket
# layer's disallowed list. See docs/deploy-cloudflare.md step 4.
EMAIL_SERVER=smtps://api_token:your-cloudflare-api-token@smtp.mx.cloudflare.net:465

# Meta, for Instagram and Facebook. The Instagram app ID is a different number
# from the Facebook app ID; see docs/setup.md#instagram-setup.
META_GRAPH_API_VERSION=v25.0
INSTAGRAM_APP_ID=your-instagram-app-id
INSTAGRAM_APP_SECRET=your-instagram-app-secret
FACEBOOK_APP_ID=your-facebook-app-id
FACEBOOK_APP_SECRET=your-facebook-app-secret
WEBHOOK_VERIFY_TOKEN=replace-with-a-webhook-verify-token

# TikTok. The webhook rejects every delivery until TIKTOK_WEBHOOK_SECRET is set,
# deliberately: TikTok does not document its signing scheme, and this endpoint
# triggers outbound activity on a creator's account. The account's own
# business_id is stored per connected account, not here, because one instance
# serves many creators. See docs/setup.md#tiktok-setup.
TIKTOK_WEBHOOK_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# Polling. Defaults shown; both are optional.
COMMENT_POLL_MAX_PER_SWEEP=30
COMMENT_POLL_LOOKBACK_HOURS=72

# Reviewer access key. Used to access the reviewer link without admin approval of a user.
REVIEWER_EMAIL=review@example.com
REVIEWER_ACCESS_KEY=replace-with-a-strong-random-secret

# Addresses allowed to sign in while no platform admin exists yet.
# Comma-separated. Registration is invitation-only, so on a brand-new install
# there is nobody who can send the first invitation; this is the way in.
#
# It disarms itself: it is only consulted when the PlatformGrant table is
# completely empty, so the moment you grant the first admin it stops being
# reachable and leaving it set cannot become a standing backdoor.
BOOTSTRAP_ADMIN_EMAILS=


